cpu: CPU.CortexM @ sysbus
    nvic: nvic
    cpuType: "cortex-m4f"
    PerformanceInMips: 48

flash: Memory.MappedMemory @ sysbus 0x000000
    // 352 kB of FLASH
    size: 0x100000

rom: Memory.MappedMemory @ sysbus 0x10000000
    // 255 kB of Boot ROM
    size: 0x20000

ram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x14000

// Bit Banding is implemented as usual, and used by TI DriverLib:
// 32 MB above Peripheral base and above SRAM base. (hex: 2000000)
// this one is for SRAM - based at 20000000 so 22000000
// and for a single MB, so size 0x100000 * 0x20 -> 0x2000000
// See: Cortex M4 Processor Technical Reference Manual.pdf section 3.7 Bit-banding
bitband_sram: Miscellaneous.BitBanding @ sysbus <0x22000000, +0x2000000>
    peripheralBase: 0x20000000

bitband_peripheral: Miscellaneous.BitBanding @ sysbus <0x42000000, +0x2000000>
    peripheralBase: 0x40000000

// unhandled read from offset 0x8, and write of 2 to same
nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    systickFrequency: 1000000
    IRQ -> cpu@0

// There is an SSI0 at 40000000 but did not check if it is the same as 2538
ssi0: SPI.CC2538_SSI @ sysbus 0x40000000
    -> nvic@7

uart0: UART.PL011 @ sysbus 0x40001000
    -> nvic@5

// ditto
ssi1: SPI.CC2538_SSI @ sysbus 0x40008000
    -> nvic@34

uart1: UART.PL011 @ sysbus 0x4000B000
    -> nvic@6

uDma: DMA.UDMA @ sysbus 0x40020000
    -> nvic@46

// TODO: byte write support
// 23:11:58.0762 [WARNING] gpioA: [cpu: 0x3F6A] Attempted Byte write isn't supported by the peripheral. Offset 0x6, value 0x0.
// Proper support requires allowing byte access to the first 32 bytes
// note that due to bit-banding, you can also use 0x80 (read write to all 32 bits) via the bit banding region to get double word
// access - I guess byte access is sometimes preferable?
// anyway: for now just use memory mapping. The CC2538 is completely different it seems (no byte addressable registers)
gpioA: Memory.MappedMemory @ sysbus 0x40022000
    size: 0x1000

// hmm? is there crypto?
crypto: Miscellaneous.CC2538_Cryptoprocessor @ sysbus 0x40024000
    -> nvic@143

// TODO: flash is totally different ; for now just add a memory mapped node to fill the missing size
// need to build with a new peripheral class.
// flashCtrl: MTD.CC1352FlashController @ sysbus 0x40030000
flashCtrl: MTD.CC2538FlashController @ sysbus 0x40030000
    flash: flash

flashCtrlMissing: Memory.MappedMemory @ sysbus 0x40031000
    size: 0x2000
    //init:

// TODO: peripheral
vims: Memory.MappedMemory @ sysbus 0x40034000
    size: 0x1000
    init:
        // STAT 8.7.2.1
        WriteDoubleWord 0x0 0x0
        // CTL 8.7.2.2
        WriteDoubleWord 0x4 0x0

// this is definitely wrong, cc1352r2 radio is totally different,
// there is a register based interface plus RAM from the Radio's cortex-M0 mapped
// into same global address space.
radio: Wireless.CC13x2RF @ sysbus 0x40040000
    // do I need to define size twice? I thought it is defined in the preipheral with
    //    82          public long Size { get { return 0x4000; } }
    // via implementing IKnownSize
    IRQ -> nvic@141 | nvic@26

// raising interrupt 44 (seems to be the right now)
// sysbus.nvic SetPendingIRQ 44
// triggers this endless loop: (so: missing emulation - need to return some value)
// 01:03:37.9070 [INFO] cpu: Entering function runCalibrateFsm at 0x4802
// 01:03:37.9072 [WARNING] sysbus: [cpu: 0x4802] ReadDoubleWord from non existing peripheral at 0x400C6054.

watchdog: Timers.CC2538Watchdog @ sysbus 0x40080000
    periodInMs: 500

ioc: Memory.MappedMemory @ sysbus 0x40081000
    size: 0x1000

// TODO: peripheral. Right now just emulating the on reset values
// from swcu185e.pdf
prcm: Memory.MappedMemory @ sysbus 0x40082000
    size: 0x1000
    init:
        // PDSTAT0 7.8.2.50
        // set to PRCM_PDSTAT0_PERIPH_ON to match expectation by Power_setDependency from GPIO_Init
        WriteDoubleWord 0x140 0x6
        // PDSTAT1 7.8.2.58
        WriteDoubleWord 0x194 0x0000001A
        // allow PRCMLoadGet to return true.
        // ClockLoadCtl
        WriteDoubleWord 0x28 0x2
        // permit all RF modes for RF_open to succeed
        WriteDoubleWord 0x1D4 0xf
        // PRCMPowerDomainsAllOn(1) should return PRCM_DOMAIN_POWER_ON
        // 651      ui32StatusRegister0 = HWREG(PRCM_BASE + NONSECURE_OFFSET + PRCM_O_PDSTAT0);                                                                                                                                                                                   │
        // 652      ui32StatusRegister1 = HWREG(PRCM_BASE + NONSECURE_OFFSET + PRCM_O_PDSTAT1);
        // PRCM_O_PDSTAT0 - RFC on (1) and Periph on (4) and Serial on (2)
        WriteDoubleWord 0x140 7
        // PRCM_O_PDSTAT1 - RFC on (RFC = RF Core)
        WriteDoubleWord 0x194 4
        // Now getting stuck at wait for interrupt (wfi) - so we need to actually emulate something. In this case
        // The RFC is supposed to answer because it was poked in some way. Oh bugger.
        // #0  PowerCC26XX_standbyPolicy () at dpl/PowerCC26X2_nortos.c:101
        // #1  0x00004f10 in SemaphoreP_pend (handle=handle@entry=0x200006c8 <rfObject+80>, timeout=timeout@entry=4294967295) at dpl/SemaphoreP_nortos.c:234
        // #2  0x00003628 in RF_pendCmd (bmEvent=8070450532247928842, ch=1, h=0x20000678 <rfObject>) at /project/source/ti/drivers/rf/RFCC26X2_multiMode.c:5156
        // #3  RF_pendCmd (h=0x20000678 <rfObject>, ch=<optimized out>, bmEvent=<optimized out>) at /project/source/ti/drivers/rf/RFCC26X2_multiMode.c:5090
        // #4  0x0000104a in EasyLink_init (params=0x200056d0) at ../easylink/EasyLink_nortos.c:1081
        // #5  0x00000458 in mainThread (arg0=0x0 <resetVectors>) at ../rfEasyLinkEchoRx_nortos.c:138
        // #6  0x000015a2 in main () at ../main_nortos.c:61

aon_pmctl: Memory.MappedMemory @ sysbus 0x40090000
    size: 0x2000

aon_rtc: Memory.MappedMemory @ sysbus 0x40092000
    size: 0x1000

aon_event: Memory.MappedMemory @ sysbus 0x40093000
    size: 0x1000

// AON_IOC AON I/O Controller 0x4009 4000
// Chapter 13 - I/O Controller (page 1089 in "CC13x2,CC26x2 SimpleLinkTM Wireless MCU Technical Reference Manual (Rev. F)")
aoi_ioc: Memory.MappedMemory @ sysbus 0x40094000
    size: 0x1000

aon_batmon: Memory.MappedMemory @ sysbus 0x40095000
    size: 0x1000

aux_ddi0_osc: Memory.MappedMemory @ sysbus 0x400CA000
    size: 0x1000

// Radio uses this for calibration - AUX_SYSIF_TDCCLKCTL_ACK
// aux_sysif: Memory.MappedMemory @ sysbus 0x400C6000
//     size: 0x1000
aux_sysif: Python.PythonPeripheral @ sysbus 0x400C6000
    size: 0x1000
    initable: true
    filename: "scripts/pydev/cc13x2_aux_sysif.py"

// TODO: read only constants ; is there no better way to implement??
ffcg1: Memory.MappedMemory @ sysbus 0x50001000
    size: 0x1000
    init:
        // FCFG1_ICEPICK_DEVICE_ID
        WriteDoubleWord 0x318 0x3bb4102f
        // FCFG1_REVISION
        WriteDoubleWord 0x31C 0x2A

// TODO peripheral
ccfg: Memory.MappedMemory @ sysbus 0x50003000
    size: 0x2000
    init:
        // SIZE_AND_DIS_FLAGS 11.2.1.3
        WriteDoubleWord 0x1FB0 0xffffffff
        // MODE_CONF 11.2.1.4
        WriteDoubleWord 0x1FB4 0xffffffff

// 23:11:57.8829 [INFO] cpu: Entering function NOROM_SetupTrimDevice at 0x5CC4
// 23:11:57.8841 [WARNING] sysbus: [cpu: 0x5CC4] WriteDoubleWord to non existing peripheral at 0x42600484, value 0x0.
// 23:11:57.8851 [WARNING] sysbus: [cpu: 0x10004356] ReadDoubleWord from non existing peripheral at 0x4268000C.
// 23:11:57.8866 [WARNING] sysbus: [cpu: 0x5CD2] ReadDoubleWord from non existing peripheral at 0x43280180.
// 23:11:57.8878 [WARNING] sysbus: [cpu: 0x5D18] WriteDoubleWord to non existing peripheral at 0x4324001C, value 0x1.
// 23:11:57.8918 [WARNING] sysbus: [cpu: 0x5D28] WriteDoubleWord to non existing peripheral at 0x43240000, value 0x1.
// 23:11:57.8921 [WARNING] sysbus: [cpu: 0x5D28] ReadDoubleWord from non existing peripheral at 0x4268000C.
// 23:11:57.9798 [WARNING] sysbus: [cpu: 0x5752] WriteDoubleWord to non existing peripheral at 0x43240280, value 0x1.
// 23:11:57.9854 [WARNING] sysbus: [cpu: 0x44EE] WriteDoubleWord to non existing peripheral at 0x60082028, value 0x1.

sysbus:
    init:
        // bit-banding was the mystery. not documented in the CC13x2 manual since it is a core M4 feature.
        Tag <0x400D2000, 0x400D2FFF> "SYS_CTRL_CLOCK_CTRL" 1
        Tag <0x40088664, 0x40088667> "RFCORE_XREG_RSSISTAT" 1
        Tag <0x400D2004, 0x400D2007> "CLOCK_STATUS" 0x10004B0
        Tag <0x400D7000, 0x400D70FF> "ADC"
        Tag <0x40010000, 0x40010FFF> "GPTIMER0"
        Tag <0x40011000, 0x40011FFF> "GPTIMER1"
        Tag <0x40012000, 0x40012FFF> "GPTIMER2"
        Tag <0x40013000, 0x40013FFF> "GPTIMER3"
        Tag <0x40080000, 0x400800FF> "STIMER_WTDG"

// Remaining:
// flash ctrl emulation
// radio emulation
// 00:19:18.9896 [WARNING] sysbus: [cpu: 0x44EE] WriteDoubleWord to non existing peripheral at 0x60082028, value 0x1.
// 00:19:19.1741 [WARNING] sysbus: [cpu: 0x2C74] WriteDoubleWord to non existing peripheral at 0x60040000, value 0x7.
