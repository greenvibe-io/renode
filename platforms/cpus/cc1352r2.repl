uDma: DMA.UDMA @ sysbus 0x40020000
    -> nvic@46

uart0: UART.PL011 @ sysbus 0x40001000
    -> nvic@5

watchdog: Timers.CC2538Watchdog @ sysbus 0x40080000
    periodInMs: 500

uart1: UART.PL011 @ sysbus 0x4000B000
    -> nvic@6

ram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x14000

gpioA: GPIOPort.CC2538_GPIO @ sysbus 0x40022000
    -> nvic@0

rom: Memory.MappedMemory @ sysbus 0x10000000
    size: 0x20000

flash: Memory.MappedMemory @ sysbus 0x000000
    size: 0x100000

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    systickFrequency: 1000000
    IRQ -> cpu@0

cpu: CPU.CortexM @ sysbus
    nvic: nvic
    cpuType: "cortex-m4f"
    PerformanceInMips: 48

radio: Wireless.CC2538RF @ sysbus 0x40040000
    IRQ -> nvic@141 | nvic@26

bitband: Miscellaneous.BitBanding @ sysbus <0x22000000, +0x20000>
    peripheralBase: 0x20000000

crypto: Miscellaneous.CC2538_Cryptoprocessor @ sysbus 0x40024000
    -> nvic@143

flashCtrl: MTD.CC2538FlashController @ sysbus 0x40030000
    flash: flash

ssi0: SPI.CC2538_SSI @ sysbus 0x40000000
    -> nvic@7

ssi1: SPI.CC2538_SSI @ sysbus 0x40008000
    -> nvic@34

// TODO: read only constants ; is there no better way to implement??
ffcg1: Memory.MappedMemory @ sysbus 0x50001000
    size: 0x1000
    init:
        // FCFG1_ICEPICK_DEVICE_ID
        WriteDoubleWord 0x318 0x3bb4102f
        // FCFG1_REVISION
        WriteDoubleWord 0x31C 0x2A

// TODO: peripheral. Right now just emulating the on reset values
// from swcu185e.pdf
prcm: Memory.MappedMemory @ sysbus 0x40082000
    size: 0x1000
    init:
        // PDSTAT0 7.8.2.50
        WriteDoubleWord 0x140 0x0
        // PDSTAT1 7.8.2.58
        WriteDoubleWord 0x194 0x0000001A


sysbus:
    init:
        Tag <0x400D2000, 0x400D2FFF> "SYS_CTRL_CLOCK_CTRL" 1
        Tag <0x40088664, 0x40088667> "RFCORE_XREG_RSSISTAT" 1
        Tag <0x400D2004, 0x400D2007> "CLOCK_STATUS" 0x10004B0
        Tag <0x400D7000, 0x400D70FF> "ADC"
        Tag <0x40010000, 0x40010FFF> "GPTIMER0"
        Tag <0x40011000, 0x40011FFF> "GPTIMER1"
        Tag <0x40012000, 0x40012FFF> "GPTIMER2"
        Tag <0x40013000, 0x40013FFF> "GPTIMER3"
        Tag <0x40080000, 0x400800FF> "STIMER_WTDG"
