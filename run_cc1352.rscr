verboseMode True
mach create
machine LoadPlatformDescription @platforms/cpus/cc1352r2.repl
using sysbus
showAnalyzer uart0
cpu GetRegistersValues
# Debugging measures
cpu LogFunctionNames true
sysbus LogAllPeripheralsAccess true
# cpu EnableExecutionTracing @path-to-file <mode>
# Load ROM
sysbus LoadELF "../ti_rtos_cc13x2_cc26x2/rom/driverlib.elf"
# Load program
sysbus LoadELF "../gv-usd-device-and-hub/gvdevice/gvdevice.out"
cpu GetRegistersValues
machine StartGdbServer 3333
